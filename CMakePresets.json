                    "type": "configure",
                    "name": "linux-core-null"
                },
                {
                    "type": "build",
                    "name": "linux-core-null"
                }
            ]
        },
        {
            "name": "macos-core-null",
            "steps": [
                {
                    "type": "configure",
                    "name": "macos-core-null"
                },
                {
                    "type": "build",
                    "name": "macos-core-null"
                }
            ]
        },
        {
            "name": "android-core-null",
            "steps": [
                {
                    "type": "configure",
                    "name": "android-core-null"
                },
                {
                    "type": "build",
                    "name": "android-core-null"
                }
            ]
        },
        {
            "name": "linux-dxvk",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux-dxvk"
                },
                {
                    "type": "build",
                    "name": "linux-dxvk"
                }
