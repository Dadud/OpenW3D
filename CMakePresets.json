            ]
        },
        {
            "name": "windows-qt",
            "steps": [
                {
                    "type": "configure",
                    "name": "windows-qt"
                },
                {
                    "type": "build",
                    "name": "windows-qt"
                }
            ]
        },
        {
            "name": "windows-qt-tools",
            "steps": [
                {
                    "type": "configure",
                    "name": "windows-qt-tools"
                },
                {
                    "type": "build",
                    "name": "windows-qt-tools"
                }
            ]
        },
        {
