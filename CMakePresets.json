{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "generator": "Ninja Multi-Config",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Release,Debug,RelWithDebInfo>:Embedded>",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "win",
            "inherits": "default",
            "hidden": false,
            "displayName": "Windows builds",
            "cacheVariables": {
                "W3D_COMPILER_FLAGS": "/W3"
            }
        },
        {
            "name": "windows-qt",
            "inherits": "win",
            "displayName": "Windows + Qt (x64)",
            "binaryDir": "C:/build/openw3d/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_INSTALLED_DIR": "C:/vcpkg.installed",
                "W3D_BUILD_QT_TOOLS": "ON"
            }
        },
        {
            "name": "windows-qt-tools",
            "inherits": "windows-qt",
            "displayName": "Windows + Qt (Tools only)",
            "cacheVariables": {
                "W3D_CLIENT": "OFF",
                "W3D_FDS": "OFF",
                "W3D_TOOLS": "ON"
            }
        },
        {
            "name": "linux",
            "inherits": "default",
            "displayName": "Linux builds",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-qt",
            "inherits": "linux",
            "displayName": "Linux + Qt (x64)",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "W3D_BUILD_QT_TOOLS": "ON"
            }
        },
        {
            "name": "core-null",
            "inherits": "default",
            "hidden": true,
            "displayName": "Portable core/null renderer build",
            "description": "Build renderer-neutral static libraries only; no app/audio/tools/renderer stack.",
            "cacheVariables": {
                "W3D_RENDERER": "NULL",
                "W3D_CLIENT": "OFF",
                "W3D_FDS": "OFF",
                "W3D_TOOLS": "OFF",
                "W3D_BUILD_OPTION_SDL3": "OFF",
                "W3D_BUILD_OPTION_FFMPEG": "OFF",
                "W3D_BUILD_OPTION_OPENAL": "OFF",
                "W3D_BUILD_OPTION_FREETYPE": "OFF",
                "W3D_BUILD_QT_TOOLS": "OFF"
            }
        },
        {
            "name": "windows-core-null",
            "inherits": "core-null",
            "displayName": "Windows core/null renderer",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-core-null",
            "inherits": "core-null",
            "displayName": "Linux core/null renderer",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-core-null",
            "inherits": "core-null",
            "displayName": "macOS core/null renderer",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "android-core-null",
            "inherits": "core-null",
            "displayName": "Android arm64 core/null renderer",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/android-core-null",
            "cacheVariables": {
                "W3D_RENDERER": "NULL",
                "W3D_CLIENT": "OFF",
                "W3D_FDS": "OFF",
                "W3D_TOOLS": "OFF",
                "W3D_BUILD_OPTION_SDL3": "OFF",
                "W3D_BUILD_OPTION_FFMPEG": "OFF",
                "W3D_BUILD_OPTION_OPENAL": "OFF",
                "W3D_BUILD_OPTION_FREETYPE": "OFF",
                "W3D_BUILD_QT_TOOLS": "OFF",
                "CMAKE_TOOLCHAIN_FILE": "cmake/android-aarch64.cmake"
            }
        },
        {
            "name": "linux-dxvk",
            "inherits": "linux",
            "displayName": "Linux DXVK renderer probe",
            "cacheVariables": {
                "W3D_RENDERER": "DXVK",
                "W3D_BUILD_OPTION_SDL3": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "android-dxvk-probe",
            "displayName": "Android arm64 DXVK renderer probe",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/android-dxvk-probe",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "cmake/android-aarch64.cmake",
                "W3D_RENDERER": "DXVK",
                "W3D_CLIENT": "ON",
                "W3D_FDS": "OFF",
                "W3D_TOOLS": "OFF",
                "W3D_BUILD_OPTION_SDL3": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win",
            "configurePreset": "win",
            "displayName": "Build Windows build",
            "description": "Build Windows build",
            "configuration": "Release"
        },
        {
            "name": "windows-qt",
            "configurePreset": "windows-qt",
            "displayName": "Build Windows + Qt",
            "description": "Build Qt-enabled Windows binaries",
            "configuration": "Release"
        },
        {
            "name": "windows-qt-tools",
            "configurePreset": "windows-qt-tools",
            "displayName": "Build Windows + Qt (Tools only)",
            "description": "Build Qt-enabled tools only",
            "configuration": "Release"
        },
        {
            "name": "linux-qt",
            "configurePreset": "linux-qt",
            "displayName": "Build Linux + Qt",
            "description": "Build Qt-enabled Linux binaries",
            "configuration": "Release"
        },
        {
            "name": "windows-core-null",
            "configurePreset": "windows-core-null",
            "displayName": "Build windows-core-null",
            "description": "Build windows-core-null",
            "configuration": "Release"
        },
        {
            "name": "linux-core-null",
            "configurePreset": "linux-core-null",
            "displayName": "Build linux-core-null",
            "description": "Build linux-core-null",
            "configuration": "Release"
        },
        {
            "name": "macos-core-null",
            "configurePreset": "macos-core-null",
            "displayName": "Build macos-core-null",
            "description": "Build macos-core-null",
            "configuration": "Release"
        },
        {
            "name": "android-core-null",
            "configurePreset": "android-core-null",
            "displayName": "Build android-core-null",
            "description": "Build android-core-null",
            "configuration": "Release"
        },
        {
            "name": "linux-dxvk",
            "configurePreset": "linux-dxvk",
            "displayName": "Build linux-dxvk",
            "description": "Build linux-dxvk",
            "configuration": "Release"
        },
        {
            "name": "android-dxvk-probe",
            "configurePreset": "android-dxvk-probe",
            "displayName": "Build android-dxvk-probe",
            "description": "Build android-dxvk-probe",
            "configuration": "Release"
        }
    ],
    "workflowPresets": [
        {
